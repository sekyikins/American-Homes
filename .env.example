# Copy this file to `.env.local` inside each Next.js app
# (apps/admin-dashboard/.env.local and apps/pos-system/.env.local)
# and fill in your own values. Never commit real secrets — `.env*` is gitignored.

# --- Client-side (safe to expose to the browser) ---
# Supabase project URL and the public "anon" key. The anon key is designed to be
# public and is protected by Row-Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# --- Server-side only (NEVER expose to the browser or commit) ---
# The service_role key bypasses Row-Level Security and grants full admin access.
# Set it ONLY as a secret for Supabase edge functions (e.g. `supabase secrets set`),
# never in client code or in this repo.
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
